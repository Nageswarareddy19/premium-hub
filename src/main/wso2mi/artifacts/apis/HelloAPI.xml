<?xml version-type="url" encoding="UTF-8"?>
<api context="/hello" name="HelloAPI" xmlns="http://ws.apache.org/ns/synapse">
    <resource methods="GET" uri-template="/{name}">
        <inSequence>
            <payloadFactory media-type="json">
                <format>
                    {
                    "message": Hello $1"
                    "service": "premium-hub"
                    }
                </format>
                <args>
                    <arg evaluator="xml" expression="$ctx:uri.var.name"/>
                </args>
            </payloadFactory>
            <respond/>
        </inSequence>
        <faultSequence>
        </faultSequence>
    </resource>
    <resource methods="GET" uri-template="/ping">
        <inSequence>
            <payloadFactory media-type="json">
                <format>
                        {
                            "status": "up"
                        }

                </format>
            </payloadFactory>
            <respond/>

        </inSequence>
        <faultSequence>
        </faultSequence>
    </resource>
</api>